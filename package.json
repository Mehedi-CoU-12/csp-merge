{
    "name": "csp-merge",
    "version": "0.1.5",
    "type": "module",
    "description": "Merge Content Security Policy (CSP) strings safely without breaking existing rules.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": "./dist/index.js"
    },
    "license": "MIT",
    "keywords": [
        "csp",
        "content-security-policy",
        "security",
        "headers",
        "merge",
        "nextjs",
        "express",
        "middleware"
    ],
    "scripts": {
        "build": "pnpm exec tsup src/index.ts --format esm,cjs --dts",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@types/node": "^25.0.10",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    }
}
